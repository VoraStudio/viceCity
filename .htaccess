# Sense llistat de directoris
Options -Indexes

# Fitxers ocults (.git, .env, .gitignore...). No afecta /.well-known/ perquè és un directori.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Documentació del projecte i bases de dades
<FilesMatch "(\.md|\.sqlite|\.sqlite-.*)$">
  Require all denied
</FilesMatch>

# <DirectoryMatch> no és vàlid a .htaccess: es bloquegen les carpetes amb RedirectMatch.
# includes/ i data/ també tenen el seu propi .htaccess (doble barrera)
RedirectMatch 403 ^/(.*/)?(openspec|docs|includes|data|\.git|\.github|\.atl)(/|$)

# Pàgines d'error pròpies (estàtiques, sense PHP). Sempre ruta local: una URL completa faria un 302.
# El 403 no es mapeja a propòsit: la pàgina diria «no trobada» amb estat 403 i no amagaria res.
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
