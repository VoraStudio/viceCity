# Plantilla de configuració. Copieu-la a `.env` (mai es versiona) i ompliu els valors.
# Una variable buida o absent es considera pendent: el lloc es mostra com a esborrany.
# Les variables d'entorn reals del servidor tenen prioritat sobre aquest fitxer.

# Lloc: domini definitiu amb https i sense barra final, i nom visible
VICITY_BASE_URL=
VICITY_SITE_NAME=

# Correu del formulari: destí i remitent (el remitent ha de tenir SPF i DKIM)
VICITY_MAIL_RECIPIENT=
VICITY_MAIL_SENDER=
# Opcional: si es deixa buit es deriva de VICITY_SITE_NAME com a «[nom]»
VICITY_MAIL_SUBJECT_PREFIX=

# Indexació del blog: true o false (buit = false)
VICITY_BLOG_INDEXABLE=

# Titular del lloc (avís legal i privacitat)
VICITY_OWNER_RAZON_SOCIAL=
VICITY_OWNER_NIF=
VICITY_OWNER_DOMICILIO=
VICITY_OWNER_REGISTRO_MERCANTIL=
VICITY_OWNER_EMAIL_CONTACTO=
VICITY_OWNER_TELEFONO=
VICITY_OWNER_DPD_CONTACTO=
VICITY_OWNER_AUTORIDAD_CONTROL=

# reCAPTCHA v3: clau de lloc (pública) i clau secreta
VICITY_RECAPTCHA_SITE_KEY=
VICITY_RECAPTCHA_SECRET=